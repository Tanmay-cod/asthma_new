# Database — new Supabase PostgreSQL (Transaction Pooler or direct)
DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# For local Docker dev instead:
# DATABASE_URL=postgresql+psycopg2://asthma:asthma@localhost:5432/asthma

# Supabase project (Auth)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
# Server-only — NEVER expose to frontend/ESP8266
SUPABASE_SERVICE_ROLE_KEY=

